              "    pm.expect(response).to.have.property(\"page\");\r",
              "    pm.expect(response).to.have.property(\"total_pages\");\r",
              "    pm.expect(response).to.have.property(\"total_results\");\r",
              "});\r",
              "\r",
              "// Validate results array exists\r",
              "pm.test(\"Response contains results array\", function () {\r",
              "    pm.expect(response.results).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "// Validate 20 items per page\r",
              "pm.test(\"Results contain 20 items per page\", function () {\r",
              "    pm.expect(response.results.length).to.eql(20);\r",
              "});\r",
              "\r",
              "// Validate required fields in each movie\r",
              "pm.test(\"Each movie includes id, title, vote_average, and popularity\", function () {\r",
              "    response.results.forEach(movie => {\r",
              "        pm.expect(movie).to.have.property(\"id\");\r",
              "        pm.expect(movie).to.have.property(\"title\");\r",
              "        pm.expect(movie).to.have.property(\"vote_average\");\r",
