      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "// Validate results[] and dates{} exist\r",
              "pm.test(\"results[] and dates{} exist\", function () {\r",
              "    pm.expect(jsonData).to.have.property(\"results\");\r",
              "    pm.expect(jsonData.results).to.be.an(\"array\");\r",
              "\r",
              "    pm.expect(jsonData).to.have.property(\"dates\");\r",
              "    pm.expect(jsonData.dates).to.be.an(\"object\");\r",
              "});\r",
              "\r",
              "// Validate dates has minimum and maximum\r",
              "pm.test(\"dates has minimum and maximum\", function () {\r",
              "    pm.expect(jsonData.dates).to.have.property(\"minimum\");\r",
              "    pm.expect(jsonData.dates).to.have.property(\"maximum\");\r",
              "});\r",
              "\r",
              "// Validate each movie structure\r",
              "pm.test(\"Each movie has required fields\", function () {\r",
              "    jsonData.results.forEach(function (movie) {\r",
              "        pm.expect(movie).to.have.property(\"id\");\r",
              "        pm.expect(movie).to.have.property(\"title\");\r",
              "        pm.expect(movie).to.have.property(\"release_date\");\r",
              "        pm.expect(movie).to.have.property(\"vote_count\");\r",
              "    });\r",
              "});\r",
              "\r",
              "// Validate movies are within date range\r",
              "pm.test(\"Movies are within valid date range\", function () {\r",
              "    const minDate = new Date(jsonData.dates.minimum);\r",
              "    const maxDate = new Date(jsonData.dates.maximum);\r",
              "\r",
              "    jsonData.results.forEach(function (movie) {\r",
              "        const releaseDate = new Date(movie.release_date);\r",
